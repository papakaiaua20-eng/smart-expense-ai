# ---- Supabase (required) ----
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: only needed for "ลบบัญชีถาวร" (deletes the login itself). Server-side only, never expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OCR ----
# tesseract     = default. Free, runs on this server, images never leave it. Thai + English.
# google-vision = more accurate on photos. Images are sent to Google (the app asks the user for consent first).
# none          = no OCR; users upload the slip and type the details.
OCR_PROVIDER=tesseract
GOOGLE_VISION_API_KEY=
# Max slip scans per user per hour
OCR_RATE_LIMIT_PER_HOUR=30
